<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/authPage.css" />
    <link rel="stylesheet" href="/css/styles.css" />
    <script src="/js/authPage.js" defer></script>
  </head>
  <body>
    <div class="container">
      <h1 class="authPageHeader">Login</h1>

      <form method="POST" action="/auth/login" class="from">
        <div class="inputContainer">
          <label for="username">Username</label>
          <input
            class="authPageInput"
            type="text"
            name="username"
            id="username"
            autocomplete="username"
          />
        </div>
        <div class="inputContainer">
          <label for="password">Password</label>
          <div class="passwordInputField">
            <input
              class="authPageInput"
              type="password"
              name="password"
              id="password"
              autocomplete="current-password"
            />
            <button
              type="button"
              class="passwordVisibilityBtn passwordInvisible"
            >
              <img
                src="/assets/icons/password_not_visible.svg"
                alt="show password"
              />
            </button>
          </div>
        </div>
        <button class="submitBtn" type="submit">Submit</button>
      </form>
      <p class="authFromRedirect">
        Not registered yet? <a href="/auth/register">Register now!</a>
      </p>
    </div>
  </body>
</html>
