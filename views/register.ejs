<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/authPage.css" />
    <link rel="stylesheet" href="/css/styles.css" />
    <script src="/js/authPage.js" defer></script>
  </head>
  <body>
    <div class="container">
      <h1 class="authPageHeader">Register</h1>
      <form method="POST" action="/auth/register" class="from">
        <div class="inputContainer">
          <label for="first_name">First name</label>
          <input
            class="authPageInput"
            type="text"
            name="firstName"
            id="firstName"
            autocomplete="given-name"
            autocapitalize="words"
          />
        </div>
        <div class="inputContainer">
          <label for="last_name">Last Name</label>
          <input
            class="authPageInput"
            type="text"
            name="last_name"
            id="last_name"
            autocomplete="family-name"
            autocapitalize="words"
          />
        </div>
        <div class="inputContainer">
          <label for="username">Username</label>
          <input
            class="authPageInput"
            type="text"
            name="username"
            id="username"
            autocomplete="username"
          />
        </div>
        <div class="inputContainer">
          <label for="password">Password</label>
          <div class="passwordInputField">
            <input
              class="authPageInput"
              type="password"
              name="password"
              id="password"
              autocomplete="new-password"
            />
            <button
              type="button"
              class="passwordVisibilityBtn passwordInvisible"
            >
              <img
                src="/assets/icons/password_not_visible.svg"
                alt="show password"
              />
            </button>
          </div>
        </div>

        <div class="inputContainer">
          <label for="rePassword">Re-enter the password</label>
          <div class="rePasswordInputField">
            <input
              class="authPageInput"
              type="password"
              name="rePassword"
              id="rePassword"
              autocomplete="new-password"
            />
            <button
              type="button"
              class="passwordVisibilityBtn passwordInvisible"
            >
              <img
                src="/assets/icons/password_not_visible.svg"
                alt="show password"
              />
            </button>
          </div>
        </div>
        <button class="submitBtn" type="submit">Submit</button>
      </form>
      <p class="authFromRedirect">
        Already have an account? <a href="/auth/login">Login!</a>
      </p>
    </div>
  </body>
</html>
