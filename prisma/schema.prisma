generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String        @id @default(uuid(7))
  role               String        @default("general")
  firstName          String
  lastName           String
  username           String        @unique
  passwordHash       String
  profilePictureLink String?
  bio                String?
  posts              Post[]
  comments           Comment[]
  joined_at          DateTime      @default(now())
  theme_color        String
  postVotes          PostVote[]
  commentVotes       CommentVote[]
  bookmarks          Bookmark[]
}

model Post {
  id          String     @id @default(uuid(7))
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  title       String
  description String
  published   Boolean    @default(true)
  created_at  DateTime   @default(now())
  edited_at   DateTime   @default(now())
  category    Category   @relation(fields: [categoryId], references: [id])
  categoryId  Int
  comments    Comment[]
  totalVote   Int        @default(0)
  postVotes   PostVote[]
  bookmarks   Bookmark[]
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String
  posts Post[]
  color String
}

model PostVote {
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId   String
  vote     Int    @default(0)

  @@id(name: "vote_id", [authorId, postId])
}

model Bookmark {
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String
  created_at DateTime @default(now())

  @@id(name: "bookmark_id", [authorId, postId])
}

model Comment {
  id           String        @id @default(uuid(7))
  author       User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId     String
  post         Post?         @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId       String
  created_at   DateTime      @default(now())
  edited_at    DateTime      @updatedAt
  content      String
  totalVote    Int           @default(0)
  commentVotes CommentVote[]
}

model CommentVote {
  author    User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String
  vote      Int     @default(0)

  @@id(name: "vote_id", [authorId, commentId])
}
